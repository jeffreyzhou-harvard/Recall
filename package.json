    "assets:placeholder": "tsx scripts/placeholder-assets.ts",
    "assets:hash": "tsx scripts/hash-assets.ts",
    "graph:seed": "tsx scripts/seed-graph.ts",
    "telegram": "tsx scripts/telegram.ts",

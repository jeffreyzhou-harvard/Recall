{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay - an adaptive participation layer for one live family interaction. Access changed. Authorship didn't.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",

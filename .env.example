# Recall - environment. Copy to .env.local. Never commit real keys.
#
# The 90-second judged path needs NONE of these. It runs offline on
# prerecorded media and deterministic fixtures (AGENTS.md section 9).
# Everything below only matters for the optional live side demo.

# Deepgram: final-turn STT (nova-3) and Recall-only TTS (aura-2-thalia-en).
# Never used to synthesize her voice; her original recorded spans are played back.
DEEPGRAM_API_KEY=

# Meta Model API key, for Muse Spark (muse-spark-1.3): once Recall's ladder has decided a cue is warranted, it may
# pick WHICH cue to offer; it also reads facts out of answers for graph ingestion. It only proposes; Recall's guards decide.
# Optional: leave blank and Recall's own deterministic implementations run instead. Muse Voice Transcribe is
# not used (turn-level timestamps only; the receipt needs word timings, so speech-to-text is Deepgram).
MUSE_API_KEY=

# Web calls require joint topic approval, introduction, schedule permission and a patient access key.
# Real households cannot run prerecorded calls. The isolated /present engine remains independent.
RECALL_CALL=web

# Long-lived Node process only. The scheduler checks the agreed windows every 30 seconds.
RECALL_SCHEDULER=1

# Optional designated-caregiver HTTPS handoff endpoints; chosen separately in joint setup.
# Receiver must deduplicate Idempotency-Key. Do not put phone numbers or secrets in source code.
RECALL_SAFETY_WEBHOOKS={}

# Persistent private volume for the graph, onboarding and selected household.
# Defaults to .data; do not use ephemeral storage for a deployment.
RECALL_DATA_DIR=

# A joint setup to use instead of fixtures/policy/susan-setup.json, as a path from the project root.
# Legacy fixture configuration only. Live households use their jointly agreed setup from onboarding.
RECALL_POLICY_FILE=

# Required in production to turn the schedule and to run onboarding, sent as the x-recall-operator header.
# With it unset in production nobody can. Local development can use the browser’s Open local setup action.
RECALL_OPERATOR_SECRET=

# Member-bound credentials for family routes, sent in x-recall-family. Each key belongs to exactly one
# member; requests must name that same member. Use distinct random secrets, never the operator key.
# Example: RECALL_FAMILY_CREDENTIALS='{"person:maya":"unique-secret-for-maya"}'
# Remove the former RECALL_FAMILY_SECRET setting: a configured shared key now disables access.
# Family routes require credentials in development too. The offline judged UI needs none.
RECALL_FAMILY_CREDENTIALS=

# Onboarding: households, the people in them, and every version of the joint setup they agreed. One SQLite
# file (Node's built-in node:sqlite; no service to run), under the git-ignored .data/ by default.
RECALL_ONBOARDING_DB=

# Run the live server for a household from the onboarding database (e.g. household:1) instead of the
# committed fixture family. Its joint setup is re-read before every call and every dashboard load.
# Cannot be combined with RECALL_POLICY_FILE.
RECALL_HOUSEHOLD=


# Native Ladybug graph reads over committed household snapshots (default).
# Use sqlite to run the same gated traversal directly over the durable store.
RECALL_GRAPH_READS=ladybug

# Relay - environment. Copy to .env.local. Never commit real keys.
#
# The 90-second judged path needs NONE of these. It runs offline on
# prerecorded media and deterministic fixtures (AGENTS.md section 9).
# Everything below only matters for the optional live side demo.

# Set to 1 to enable the live side demo. Anything else keeps every provider
# on fixtures. The /present route ignores this flag entirely.
RELAY_LIVE=0

# Deepgram streaming STT (word timings, endpointing, exact transcript spans).
# Never used for TTS of Mom's voice - her audio is only ever played back.
DEEPGRAM_API_KEY=

# Meta Muse (Voice Transcribe + Spark scaffold decision). Leave blank to keep
# the labeled fixture stub. Do not invent endpoints: fill these in only from
# the sponsor's real docs.
MUSE_API_KEY=
MUSE_API_BASE=

# Relay - environment. Copy to .env.local. Never commit real keys.
#
# The 90-second judged path needs NONE of these. It runs offline on
# prerecorded media and deterministic fixtures (AGENTS.md section 9).
# Everything below only matters for the optional live side demo.

# Set to 1 to enable the live side demo. Anything else keeps every provider
# on fixtures. The /present route ignores this flag entirely.
RELAY_LIVE=0

# Deepgram streaming STT (nova-3): her words with word timings, endpointing, exact transcript spans.
# REQUIRED for RELAY_CALL=video. Never used for TTS of Mom's voice - her audio is only ever played back.
DEEPGRAM_API_KEY=

# Meta Model API key, for Muse Spark (muse-spark-1.3): it chooses among the scaffolds Relay's ladder found
# eligible, and reads facts out of answers for graph ingestion. It only proposes; Relay's guards decide.
# Optional: leave blank and Relay's own deterministic implementations run instead. Muse Voice Transcribe is
# not used (turn-level timestamps only; the receipt needs word timings, so speech-to-text is Deepgram).
MUSE_API_KEY=

# --- Telegram: the family's existing thread (live only; never on the judged path) ---
# Create a bot with @BotFather and paste its token. Leave the bot's group
# privacy mode ON: Telegram then delivers only /ask commands and the one
# message they reply to, never the rest of the family's chat.
TELEGRAM_BOT_TOKEN=

# Needed for webhook mode (`npm run telegram -- webhook https://...`) and for `poll --forward`, which hands
# updates to the web app through the same route. 16-256 characters of A-Z a-z 0-9 _ -. Plain `poll` does not use it.
TELEGRAM_WEBHOOK_SECRET=

# Who is who on Telegram, as one line of JSON. Find the ids with
# `npm run telegram -- discover`. Group chat ids are negative. Personal data:
# keep it here, never in a committed file.
# {"chats":{"-1001234567890":{"thread_id":"artifact:thread-family","addressee_id":"person:mom"}},"users":{"111111111":"person:anika"}}
RELAY_TELEGRAM_BINDINGS=

# none (default): intake only - no call is placed.
# video:          a granted ask places a live video call and runs a real session over it (AGENTS.md section 20).
#                 Keep /call/host open: it is Relay's end of every call. Telegram then needs the web app to
#                 handle its updates: a webhook, or `npm run telegram -- poll --forward http://localhost:3000`.
# prerecorded:    run the session against the prerecorded golden call (side demo; label it).
RELAY_CALL=none

# 1 logs, per live call, the audio level second by second and when each turn was heard. Never her words.
RELAY_CALL_DEBUG=

# An access policy to use instead of fixtures/policy/mom-default.json, as a path from the project root.
# The default only allows calls 10:00-19:00 New York; outside that window the family gets "Not this time."
RELAY_POLICY_FILE=

# --- Video call over WebRTC (live only; never on the judged path) ---
# ICE servers, as one line of JSON. With nothing set, one public STUN server is used: fine at home or
# for two tabs on one laptop. Venue, campus, and hotel wifi usually need a TURN relay as well, or the
# call will sit on "Connecting...". Use short-lived TURN credentials; they are handed to call participants.
# [{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
RELAY_ICE_SERVERS=

# Required in production to start a call (open /call/host?operator=<this>). With it unset in
# production nobody can start one. Not needed in development.
RELAY_OPERATOR_SECRET=


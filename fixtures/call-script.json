{
  "version": 1,
  "description": "Every line Recall can say that carries no factual claim, each with a stable script id (AGENTS.md section 6.2). Slots in braces are filled only from graph node values and the joint setup. Any other line Recall says must carry citations. Changes need a second reviewer (section 13). The ladder's last rung, stating a fact outright, exists only for `procedural` topic categories: it is never said of an autobiographical or identity memory (EVIDENCE.md, section B).",
  "lines": {
    "greeting": {
      "id": "GREETING",
      "text": "Hi {name}, I'm Recall, an AI assistant {set_up_by} set up to keep you company."
    },
    "identity": {
      "id": "IDENTITY",
      "text": "I'm Recall, a computer assistant, not a person. {set_up_by} set me up to keep you company."
    },
    "store_question": {
      "id": "CONFIRM-STORE",
      "text": "Want me to remember that?"
    },
    "share_question": {
      "id": "CONFIRM-SHARE",
      "text": "Would you like me to share it with your family?"
    },
    "close_warm": {
      "id": "CLOSE-WARM",
      "text": "Thank you, {name}. It was lovely talking with you. Goodbye for now."
    },
    "close_kind": {
      "id": "CLOSE-KIND",
      "text": "That's alright. We can talk about it another time. It was lovely talking with you."
    },
    "close_not_stored": {
      "id": "CLOSE-NOT-STORED",
      "text": "That's alright. I won't keep that. It was lovely talking with you."
    },
    "narrowing": {
      "id": "NARROWING",
      "text": "I don't have enough to go on there - let's try something else."
    },
    "stop_ack": {
      "id": "STOP-ACK",
      "text": "Of course. Goodbye for now."
    },
    "safety": {
      "id": "SAFETY",
      "text": "I'm going to let {caregiver} know, so they can call you. If you need help now, please call {emergency_number}."
    },
    "family_redirect": {
      "id": "FAMILY-REDIRECT",
      "text": "{name}'s talked about this before. Want to give her a call?"
    },
    "family_nothing_yet": {
      "id": "FAMILY-NOTHING-YET",
      "text": "There's nothing to point you to yet. Want to give her a call?"
    }
  },
  "ladder": {
    "free_recall": {
      "id": "LADDER-1",
      "text": "I'd love to hear about {topic}. What comes to mind?"
    },
    "family_sourced_association": {
      "id": "LADDER-3-FAMILY-SOURCED",
      "text": "{author} mentioned {topic}. What do you remember about that?"
    },
    "elaborate_default": {
      "id": "ELABORATE",
      "text": "What do you remember about that?"
    },
    "knowledge_association": { "id": "LADDER-3-KNOWLEDGE", "text": "You mentioned {cue}. What comes to mind?" },
    "knowledge_place_association": { "id": "LADDER-3-KNOWLEDGE-PLACE", "text": "You mentioned {place}. What comes to mind?" },
    "knowledge_followups": {
      "people": { "id": "KG-PEOPLE", "text": "Who, if anyone, comes to mind with that memory?" },
      "place": { "id": "KG-PLACE", "text": "What comes to mind about the place in that memory?" },
      "occasion": { "id": "KG-OCCASION", "text": "What comes to mind about the time of year?" }
    },
    "categories": {
      "family_summers": {
        "memory_kind": "autobiographical",
        "context": {
          "id": "LADDER-2-FAMILY-SUMMERS",
          "text": "It's a place your family went together."
        },
        "association": {
          "person": {
            "id": "LADDER-3-PERSON-FAMILY-SUMMERS",
            "text": "You and {cue} used to go there together."
          },
          "photo": {
            "id": "LADDER-3-PHOTO-FAMILY-SUMMERS",
            "text": "{author} shared a photograph from there. What do you remember about that?"
          }
        },
        "recognition": {
          "id": "LADDER-4-FAMILY-SUMMERS",
          "text": "Did you go to {place} with your {option_a} or your {option_b}?"
        },
        "elaborate": {
          "id": "ELABORATE-FAMILY-SUMMERS",
          "text": "What do you remember about those summers?"
        }
      },
      "workplace": {
        "memory_kind": "autobiographical",
        "context": {
          "id": "LADDER-2-WORKPLACE",
          "text": "It's a place where you used to work."
        }
      },
      "hometown": {
        "memory_kind": "autobiographical",
        "context": {
          "id": "LADDER-2-HOMETOWN",
          "text": "It's a town where you used to live."
        }
      },
      "family_event": {
        "memory_kind": "autobiographical",
        "context": {
          "id": "LADDER-2-FAMILY-EVENT",
          "text": "It's a day your family celebrated together."
        }
      }
    }
  },
